                        <circle cx="100" cy="100" r="92" stroke="#D4AF37" stroke-width="8" fill="none" />
                        <circle cx="100" cy="100" r="82" stroke="#D4AF37" stroke-width="3" fill="none" />
                        <path d="M 82,35 L 82,165 M 118,35 L 118,165" stroke="#D4AF37" stroke-width="7" stroke-linecap="round"/>
                        <path d="M 82,100 L 118,100" stroke="#D4AF37" stroke-width="7"/>
                        <path d="M 22,100 L 82,100" stroke="#D4AF37" stroke-width="7"/>
                        <path d="M 38,55 L 82,55 M 38,145 L 82,145" stroke="#D4AF37" stroke-width="7"/>
                        <path d="M 90,45 L 110,45 M 90,65 L 110,65" stroke="#D4AF37" stroke-width="4"/>
                        <path d="M 90,135 L 110,135 M 90,155 L 110,155" stroke="#D4AF37" stroke-width="4"/>
                        <path d="M 90,110 L 110,125" stroke="#D4AF37" stroke-width="5"/>
                    </svg>
                </div>
                <div class="flex flex-col text-left">
                    <span class="font-cinzel font-black text-xl sm:text-2xl tracking-widest gold-gradient-text">EFEHAN</span>
