                        <li><a href="#products-section" onclick="selectCategory('kelepce', 'Kelepçelerimiz')" class="hover:text-gold transition-colors">Kelepçelerimiz</a></li>
                        <li><a href="#products-section" onclick="selectCategory('kupe', 'Küpelerimiz')" class="hover:text-gold transition-colors">Küpelerimiz</a></li>
                        <li><a href="#products-section" onclick="selectCategory('kolye', 'Kolyelerimiz')" class="hover:text-gold transition-colors">Kolyelerimiz</a></li>
                        <li><a href="#products-section" onclick="selectCategory('kolye-ucu', 'Kolye Uçlarımız')" class="hover:text-gold transition-colors">Kolye Uçlarımız</a></li>
                        <li><a href="#products-section" onclick="selectCategory('bileklik', 'Bilekliklerimiz')" class="hover:text-gold transition-colors">Bilekliklerimiz</a></li>
                        <li><a href="#products-section" onclick="selectCategory('setler', 'Setlerimiz')" class="hover:text-gold transition-colors">Setlerimiz</a></li>
                    </ul>
                </div>

                <!-- Col 3: Detailed Contact Info (Updated) -->
                <div class="space-y-3">
                    <h3 class="font-cinzel text-sm font-bold text-white uppercase tracking-wider mb-4 border-b border-gold/30 pb-2 inline-block">İletişim Bilgileri</h3>
                    <div class="flex items-start space-x-3 text-xs text-gray-300">
                        <i class="fa-solid fa-location-dot text-gold mt-1"></i>
                        <span>Nalbantoğlu, Uzun Çarşı Fidan Han Üst Kat No: 168 Osmangazi/Bursa</span>
                    </div>
                    <div class="flex items-center space-x-3 text-xs text-gray-300">
                        <i class="fa-solid fa-phone text-gold"></i>
                        <a href="tel:05363766665" class="hover:text-gold">0536 376 66 65</a>
                    </div>
                    <div class="flex items-center space-x-3 text-xs text-gray-300">
                        <i class="fa-brands fa-whatsapp text-gold"></i>
                        <a href="https://wa.me/905363766665" target="_blank" class="hover:text-gold">0536 376 66 65 (WhatsApp Sipariş)</a>
                    </div>
                    <div class="flex items-center space-x-3 text-xs text-gray-300">
                        <i class="fa-solid fa-envelope text-gold"></i>
                        <a href="mailto:efehanalyans@hotmail.com" class="hover:text-gold">efehanalyans@hotmail.com</a>
                    </div>
                    <div class="flex items-center space-x-3 text-xs text-gray-300">
                        <i class="fa-solid fa-clock text-gold"></i>
                        <span>Pazartesi - Cumartesi: 09:00 - 19:00</span>
                    </div>
                </div>

                <!-- Col 4: Call Back Request Form -->
                <div>
                    <h3 class="font-cinzel text-sm font-bold text-white uppercase tracking-wider mb-4 border-b border-gold/30 pb-2 inline-block">Sizi Arayalım</h3>
                    <form onsubmit="handleQuickCall(event)" class="space-y-2">
                        <input type="text" required placeholder="Adınız Soyadınız" class="w-full bg-black border border-dark-border rounded px-3 py-2 text-xs text-white focus:border-gold outline-none">
                        <input type="tel" required placeholder="Telefon Numaranız" class="w-full bg-black border border-dark-border rounded px-3 py-2 text-xs text-white focus:border-gold outline-none">
                        <button type="submit" class="w-full py-2.5 text-xs font-bold uppercase tracking-wider text-black gold-gradient-bg rounded hover:brightness-110">
                            Gönder
                        </button>
                    </form>
                </div>

            </div>

            <!-- Bottom Copyright -->
            <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-[11px] text-gray-500 gap-4">
                <p>© 2026 EFEHAN GOLD ALYANS. Tüm Hakları Saklıdır.</p>
                <div class="flex space-x-4">
                    <a href="#" class="hover:text-gold">Gizlilik Politikası</a>
                    <a href="#" class="hover:text-gold">Garanti ve İade Şartları</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Toast Notification -->
    <div id="toast" class="fixed bottom-6 right-6 z-50 bg-dark-card border border-gold px-5 py-3 rounded-xl text-white text-xs shadow-2xl translate-y-24 opacity-0 transition-all duration-300 flex items-center gap-3">
        <i class="fa-solid fa-circle-check text-gold text-base"></i>
        <span id="toastMsg">İşleminiz başarıyla tamamlandı.</span>
    </div>

    <!-- JavaScript Application Engine -->
    <script>
        /* Product Database for all requested categories with prices */
        const PRODUCTS_DATA = [
            // Alyanslarımız
            { id: 1, category: 'alyans', title: 'Efehan Klasik Bombeli Alyans', price: 14500, gold: '14K', weight: '4.8 gr', desc: 'Zamansız klasik tasarım, iç konfor ergonomisi ile rahat kullanım.', icon: 'ring' },
            { id: 2, category: 'alyans', title: 'Efehan Mat & Parlak Çift Alyans', price: 21800, gold: '18K', weight: '7.2 gr', desc: 'İki renk detaylı el işçiliği mat kaplama modern alyans.', icon: 'ring' },
            { id: 3, category: 'alyans', title: 'Efehan Diamond Tek Sıra Taşlı Alyans', price: 28900, gold: '14K', weight: '5.4 gr', desc: 'Mikro zirkon mıhlamalı özel tasarım evlilik halkası.', icon: 'ring' },
            
            // Kelepçelerimiz
            { id: 4, category: 'kelepce', title: 'Efehan Kaburga Altın Kelepçe', price: 42500, gold: '14K', weight: '14.5 gr', desc: 'Görkemli kaburga formu ve parlak cilalı yüzey kaplaması.', icon: 'circle-notch' },
            { id: 5, category: 'kelepce', title: 'Efehan Taşlı Baget Kelepçe', price: 49000, gold: '18K', weight: '16.0 gr', desc: 'Işıltılı baget kesim taşlı özel davet kelepçesi.', icon: 'circle-notch' },

            // Küpelerimiz
            { id: 6, category: 'kupe', title: 'Efehan Halka Altın Küpe', price: 8400, gold: '14K', weight: '2.8 gr', desc: 'Günlük kullanım için ideal, hafif ve şık klasik halka küpe.', icon: 'certificate' },
            { id: 7, category: 'kupe', title: 'Efehan Sallantılı Baget Küpe', price: 15200, gold: '14K', weight: '4.1 gr', desc: 'Zarif sallantı detaylı göz alıcı tasarım altın küpe.', icon: 'certificate' },

            // Kolyelerimiz
            { id: 8, category: 'kolye', title: 'Efehan Zincir Baget Taşlı Kolye', price: 18600, gold: '14K', weight: '5.2 gr', desc: 'İnce işçilik altın zincirli şık baget kolye.', icon: 'heart' },
            { id: 9, category: 'kolye', title: 'Efehan İtalyan Ezme Kolye', price: 31000, gold: '14K', weight: '9.8 gr', desc: 'Modern İtalyan ezme örgü tarzı gösterişli kolye.', icon: 'heart' },

            // Kolye Uçlarımız
            { id: 10, category: 'kolye-ucu', title: 'Efehan Tuğralı Kolye Ucu', price: 11200, gold: '14K', weight: '3.6 gr', desc: 'Geleneksel motifli el oyması altın kolye ucu.', icon: 'star' },
            { id: 11, category: 'kolye-ucu', title: 'Efehan Hayat Ağacı Kolye Ucu', price: 9800, gold: '14K', weight: '3.1 gr', desc: 'Anlamlı ve şık kabartma detaylı kolye ucu.', icon: 'star' },

            // Bilekliklerimiz
            { id: 12, category: 'bileklik', title: 'Efehan İtalyan Dorika Bileklik', price: 16400, gold: '14K', weight: '4.9 gr', desc: 'Çok renkli altın dorika toplu zarif bileklik.', icon: 'link' },
            { id: 13, category: 'bileklik', title: 'Efehan Şans Figürlü Bileklik', price: 12800, gold: '14K', weight: '3.8 gr', desc: 'Nazar ve şans sembollü ince işçilik bileklik.', icon: 'link' },

            // Setlerimiz
            { id: 14, category: 'setler', title: 'Efehan Gelin Düğün Seti', price: 115000, gold: '22K / 14K', weight: '38.5 gr', desc: 'Gerdanlık, bileklik ve küpelerden oluşan tam düğün takımı.', icon: 'crown' },
            { id: 15, category: 'setler', title: 'Efehan Baget Taşlı Üçlü Mini Set', price: 54000, gold: '14K', weight: '16.2 gr', desc: 'Modern zarif baget taşlı yüzük, kolye ve küpe seti.', icon: 'crown' }
        ];

        let currentCategory = 'all';

        /* Side Navigation Drawer Controls */
        const openMenuBtn = document.getElementById('openMenuBtn');
        const closeMenuBtn = document.getElementById('closeMenuBtn');
        const sideNavDrawer = document.getElementById('sideNavDrawer');
        const sideNavOverlay = document.getElementById('sideNavOverlay');

        function openDrawer() {
            sideNavDrawer.classList.remove('-translate-x-full');
            sideNavOverlay.classList.remove('opacity-0', 'pointer-events-none');
        }

        function closeDrawer() {
            sideNavDrawer.classList.add('-translate-x-full');
            sideNavOverlay.classList.add('opacity-0', 'pointer-events-none');
        }

        openMenuBtn.addEventListener('click', openDrawer);
        closeMenuBtn.addEventListener('click', closeDrawer);
        sideNavOverlay.addEventListener('click', closeDrawer);

        /* Category Selector Logic */
        function selectCategory(cat, title) {
            currentCategory = cat;
            document.getElementById('currentCategoryTitle').innerText = title;
            closeDrawer();

            const customizerSec = document.getElementById('customizer-section');
            if (cat === 'alyans' || cat === 'all') {
                customizerSec.style.display = 'block';
            } else {
                customizerSec.style.display = 'none';
            }

            renderProducts();
            document.getElementById('products-section').scrollIntoView({ behavior: 'smooth' });
        }

        /* Render Product Cards Function */
        function renderProducts() {
            const grid = document.getElementById('productGrid');
            grid.innerHTML = '';

            const filtered = currentCategory === 'all' 
                ? PRODUCTS_DATA 
                : PRODUCTS_DATA.filter(p => p.category === currentCategory);

            if (filtered.length === 0) {
                grid.innerHTML = `<div class="col-span-full text-center py-12 text-gray-500">Bu kategoride ürün bulunamadı.</div>`;
                return;
            }

            filtered.forEach(p => {
                const card = document.createElement('div');
                card.className = "bg-dark-card rounded-xl overflow-hidden border border-dark-border hover:border-gold/50 transition-all duration-300 flex flex-col justify-between group";
                
                card.innerHTML = `
                    <div>
                        <div class="h-56 bg-black relative flex items-center justify-center p-6 border-b border-dark-border">
                            <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-gold/10 to-transparent"></div>
                            
                            <div class="w-28 h-28 flex items-center justify-center text-gold group-hover:scale-110 transition-transform duration-500">
                                <i class="fa-solid fa-${p.icon} text-6xl opacity-90 drop-shadow-[0_0_15px_rgba(212,175,55,0.4)]"></i>
                            </div>

                            <span class="absolute top-3 left-3 text-[10px] font-bold tracking-widest text-gold bg-black/80 border border-gold/30 px-2 py-0.5 rounded uppercase">
                                ${p.gold} ALTIN
                            </span>
                            <span class="absolute top-3 right-3 text-[10px] text-gray-400 bg-dark-panel px-2 py-0.5 rounded">
                                ${p.weight}
                            </span>
                        </div>
                        <div class="p-5">
                            <h3 class="font-cinzel text-base font-bold text-white group-hover:text-gold transition-colors">${p.title}</h3>
                            <p class="text-gray-400 text-xs mt-2 line-clamp-2 leading-relaxed font-light">${p.desc}</p>
                        </div>
                    </div>
                    <div class="p-5 pt-0 border-t border-white/5 mt-4 flex items-center justify-between">
                        <div>
                            <span class="text-[10px] text-gray-500 block uppercase">Fiyat</span>
                            <span class="font-cinzel text-lg font-extrabold text-gold">₺${p.price.toLocaleString('tr-TR')}</span>
                        </div>
                        <button onclick="orderProduct('${p.title}', '₺${p.price.toLocaleString('tr-TR')}')" class="px-3 py-2 text-xs font-semibold uppercase tracking-wider text-black gold-gradient-bg rounded hover:brightness-110 transition-all">
                            Sipariş Ver
                        </button>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        /* Sort Products */
        function sortProducts() {
            const sortVal = document.getElementById('sortSelect').value;
            if (sortVal === 'low-high') {
                PRODUCTS_DATA.sort((a, b) => a.price - b.price);
            } else if (sortVal === 'high-low') {
                PRODUCTS_DATA.sort((a, b) => b.price - a.price);
            }
            renderProducts();
        }

        /* Order & Toast Notifications */
        function orderProduct(title, price) {
            showToast(`"${title}" (${price}) talebiniz alındı! WhatsApp açılıyor...`);
            setTimeout(() => {
                window.open(`https://wa.me/905363766665?text=Merhaba,%20${encodeURIComponent(title)}%20(${price})%20hakkında%20bilgi%20ve%20sipariş%20vermek%20istiyorum.`, '_blank');
            }, 1500);
        }

        function handleQuickCall(e) {
            e.preventDefault();
            showToast("Talebiniz alındı! En kısa sürede sizinle iletişime geçeceğiz.");
            e.target.reset();
        }

        function showToast(msg) {
            const toast = document.getElementById('toast');
            document.getElementById('toastMsg').innerText = msg;
            toast.classList.remove('translate-y-24', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-24', 'opacity-0');
            }, 3500);
        }

        /* THREE.JS 3D RING ENGINE FOR ALYANS */
        let scene, camera, renderer, ringMesh, textCanvas, textTexture;
        let ringColorHex = 0xD4AF37;
        let ringTubeRadius = 0.35;

        function init3DRing() {
            const container = document.getElementById('canvas-container');
            if(!container) return;

            scene = new THREE.Scene();

            camera = new THREE.PerspectiveCamera(45, container.clientWidth / container.clientHeight, 0.1, 1000);
            camera.position.set(0, 2, 5);
            camera.lookAt(0, 0, 0);

            renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
            renderer.setSize(container.clientWidth, container.clientHeight);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            container.appendChild(renderer.domElement);

            const ambientLight = new THREE.AmbientLight(0xffffff, 1.5);
            scene.add(ambientLight);

            const dirLight = new THREE.DirectionalLight(0xfff5ea, 2.5);
            dirLight.position.set(5, 10, 7);
            scene.add(dirLight);

            textCanvas = document.createElement('canvas');
            textCanvas.width = 1024;
            textCanvas.height = 128;
            updateCanvasText("EFEHAN GOLD");

            textTexture = new THREE.CanvasTexture(textCanvas);
            textTexture.wrapS = THREE.RepeatWrapping;
            textTexture.wrapT = THREE.RepeatWrapping;

            createRing();

            let isDragging = false;
            let prevMouse = { x: 0, y: 0 };
            const elem = renderer.domElement;

            elem.addEventListener('mousedown', (e) => {
                isDragging = true;
                prevMouse = { x: e.clientX, y: e.clientY };
            });

            elem.addEventListener('mousemove', (e) => {
                if (!isDragging || !ringMesh) return;
                const deltaX = e.clientX - prevMouse.x;
                const deltaY = e.clientY - prevMouse.y;
                ringMesh.rotation.y += deltaX * 0.01;
                ringMesh.rotation.x += deltaY * 0.01;
                prevMouse = { x: e.clientX, y: e.clientY };
            });

            window.addEventListener('mouseup', () => { isDragging = false; });

            window.addEventListener('resize', () => {
                if (!container || !renderer || !camera) return;
                camera.aspect = container.clientWidth / container.clientHeight;
                camera.updateProjectionMatrix();
                renderer.setSize(container.clientWidth, container.clientHeight);
            });

            function animate() {
                requestAnimationFrame(animate);
                if (ringMesh && !isDragging) {
                    ringMesh.rotation.y += 0.003;
                }
                renderer.render(scene, camera);
            }
            animate();
        }

        function createRing() {
            if (ringMesh) scene.remove(ringMesh);
            const geometry = new THREE.TorusGeometry(1.4, ringTubeRadius, 32, 100);
            const material = new THREE.MeshStandardMaterial({
                color: ringColorHex,
                metalness: 0.95,
                roughness: 0.2,
                map: textTexture
            });
            ringMesh = new THREE.Mesh(geometry, material);
            ringMesh.rotation.x = Math.PI / 4;
            scene.add(ringMesh);
        }

        function updateCanvasText(txt) {
            const ctx = textCanvas.getContext('2d');
            ctx.fillStyle = '#ffffff';
            ctx.fillRect(0, 0, textCanvas.width, textCanvas.height);
            ctx.fillStyle = '#000000';
            ctx.font = 'Bold 36px Montserrat, sans-serif';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText(txt, textCanvas.width / 2, textCanvas.height / 2);
            if (textTexture) textTexture.needsUpdate = true;
        }

        /* Customizer Controls Event Listeners */
        document.querySelectorAll('.metal-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                document.querySelectorAll('.metal-btn').forEach(b => {
                    b.classList.remove('active', 'border-2', 'border-gold');
                    b.classList.add('border-dark-border');
                });
                const target = e.currentTarget;
                target.classList.add('active', 'border-2', 'border-gold');
                target.classList.remove('border-dark-border');

                const color = target.getAttribute('text-color');
                const label = document.getElementById('ringMaterialName');

                if (color === 'yellow') {
                    ringColorHex = 0xD4AF37;
                    label.innerText = "14K Sarı Altın";
                } else if (color === 'white') {
                    ringColorHex = 0xE5E8E8;
                    label.innerText = "18K Beyaz Altın";
                } else if (color === 'rose') {
                    ringColorHex = 0xE8A598;
                    label.innerText = "14K Rose Gold";
                }

                if (ringMesh) ringMesh.material.color.setHex(ringColorHex);
            });
        });

        const widthSlider = document.getElementById('widthSlider');
        widthSlider.addEventListener('input', (e) => {
            const val = parseFloat(e.target.value);
            document.getElementById('widthValue').innerText = val.toFixed(1) + " mm";
            ringTubeRadius = 0.2 + (val * 0.035);
            createRing();
            document.getElementById('estimatedPrice').innerText = "₺" + Math.round(14000 + (val * 1100)).toLocaleString('tr-TR');
        });

        document.getElementById('engravingInput').addEventListener('input', (e) => {
            updateCanvasText(e.target.value || "EFEHAN GOLD");
        });

        document.getElementById('resetCameraBtn').addEventListener('click', () => {
            if (ringMesh) ringMesh.rotation.set(Math.PI / 4, 0, 0);
        });

        document.getElementById('orderCustomRingBtn').addEventListener('click', () => {
            const txt = document.getElementById('engravingInput').value || "Belirtilmedi";
            showToast(`Özel Alyans Sipariş Talebiniz Alındı! (İç Yazı: "${txt}")`);
        });

        // Initialize App
        window.onload = function() {
            renderProducts();
            init3DRing();
        };
    </script>
</body>
</html>
