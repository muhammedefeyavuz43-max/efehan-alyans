                        <button id="orderCustomRingBtn" class="px-5 py-3 text-xs font-bold uppercase tracking-wider text-black gold-gradient-bg rounded-lg hover:brightness-110">
                            Sipariş Ver
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Main Products Showcase Section -->
    <section id="products-section" class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
