                <button onclick="selectCategory('kelepce', 'Kelepçelerimiz')" class="px-4 py-2 text-xs font-semibold rounded-full bg-dark-card border border-gold/30 hover:border-gold hover:text-gold transition-all">Kelepçeler</button>
                <button onclick="selectCategory('kupe', 'Küpelerimiz')" class="px-4 py-2 text-xs font-semibold rounded-full bg-dark-card border border-gold/30 hover:border-gold hover:text-gold transition-all">Küpeler</button>
                <button onclick="selectCategory('kolye', 'Kolyelerimiz')" class="px-4 py-2 text-xs font-semibold rounded-full bg-dark-card border border-gold/30 hover:border-gold hover:text-gold transition-all">Kolyeler</button>
                <button onclick="selectCategory('kolye-ucu', 'Kolye Uçlarımız')" class="px-4 py-2 text-xs font-semibold rounded-full bg-dark-card border border-gold/30 hover:border-gold hover:text-gold transition-all">Kolye Uçları</button>
                <button onclick="selectCategory('bileklik', 'Bilekliklerimiz')" class="px-4 py-2 text-xs font-semibold rounded-full bg-dark-card border border-gold/30 hover:border-gold hover:text-gold transition-all">Bileklikler</button>
