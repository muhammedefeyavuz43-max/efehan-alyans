                <button onclick="selectCategory('kupe', 'Küpelerimiz')" class="cat-nav-item w-full flex items-center justify-between px-4 py-3.5 rounded-lg text-sm font-semibold tracking-wider text-gray-200 hover:text-gold hover:bg-gold/10 transition-all border-l-2 border-transparent hover:border-gold">
