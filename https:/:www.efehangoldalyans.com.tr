    <aside id="sideNavDrawer" class="fixed top-0 left-0 w-80 sm:w-96 h-full bg-dark-panel border-r border-gold/30 z-50 -translate-x-full flex flex-col justify-between shadow-2xl">
        <div>
            <!-- Drawer Header -->
            <div class="p-6 border-b border-dark-border flex items-center justify-between">
                <div class="flex items-center space-x-3">
                    <div class="w-8 h-8">
                        <svg viewBox="0 0 200 200" class="w-full h-full">
