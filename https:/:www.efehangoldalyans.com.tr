                <a href="https://wa.me/905363766665" target="_blank" class="w-10 h-10 rounded-lg border border-gold/40 flex items-center justify-center text-gold hover:bg-gold hover:text-black transition-all">
                    <i class="fa-brands fa-whatsapp text-lg"></i>
