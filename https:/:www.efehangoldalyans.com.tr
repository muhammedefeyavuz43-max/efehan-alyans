    <!-- Interactive 3D Customizer Section (Visible for Alyans category) -->
    <section id="customizer-section" class="py-16 bg-dark-panel border-b border-dark-border">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-10">
                <span class="text-xs uppercase font-bold tracking-widest text-gold">İnteraktif Alyans Atölyesi</span>
                <h2 class="font-cinzel text-2xl sm:text-4xl font-bold text-white mt-1">Kendi Alyansını 3D Tasarla</h2>
                <p class="text-gray-400 text-xs sm:text-sm mt-2">Altın rengini seçin, genişliği ayarlayın ve alyansın içerisine özel isminizi yazdırın.</p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
                <!-- 3D Canvas -->
                <div class="lg:col-span-7 bg-black rounded-xl border border-gold/30 p-4 relative h-[380px] sm:h-[450px] shadow-2xl flex flex-col justify-between">
                    <div class="absolute top-4 left-4 z-10 glass-panel px-3 py-1.5 rounded text-[11px] text-gray-300 flex items-center gap-2">
                        <i class="fa-solid fa-arrows-spin text-gold animate-spin"></i> 3D Görünüm (Sürükleyerek Döndürün)
                    </div>
                    <div id="canvas-container" class="w-full h-full cursor-grab active:cursor-grabbing"></div>
                    <div class="absolute bottom-4 left-4 right-4 z-10 flex justify-between items-center px-4 py-2 glass-panel rounded-lg text-xs">
                        <span id="ringMaterialName" class="text-gold font-semibold">14K Sarı Altın</span>
                        <button id="resetCameraBtn" class="text-gray-400 hover:text-gold transition-colors"><i class="fa-solid fa-rotate-left"></i> Sıfırla</button>
                    </div>
                </div>

                <!-- Customizer Controls -->
                <div class="lg:col-span-5 glass-panel p-6 rounded-xl border border-gold/20 space-y-5">
                    <div>
                        <label class="text-xs font-semibold uppercase tracking-wider text-gray-300 block mb-2">1. Altın Rengi</label>
                        <div class="grid grid-cols-3 gap-2">
                            <button text-color="yellow" class="metal-btn active border-2 border-gold p-2.5 rounded-lg flex flex-col items-center gap-1 bg-black/40">
                                <span class="w-5 h-5 rounded-full bg-amber-400"></span>
                                <span class="text-[11px] text-gray-200">Sarı Altın</span>
                            </button>
                            <button text-color="white" class="metal-btn border border-dark-border p-2.5 rounded-lg flex flex-col items-center gap-1 bg-black/40">
                                <span class="w-5 h-5 rounded-full bg-slate-200"></span>
                                <span class="text-[11px] text-gray-200">Beyaz Altın</span>
                            </button>
                            <button text-color="rose" class="metal-btn border border-dark-border p-2.5 rounded-lg flex flex-col items-center gap-1 bg-black/40">
                                <span class="w-5 h-5 rounded-full bg-rose-300"></span>
                                <span class="text-[11px] text-gray-200">Rose Gold</span>
                            </button>
                        </div>
                    </div>

                    <div>
                        <div class="flex justify-between text-xs mb-1">
                            <span class="uppercase tracking-wider font-semibold text-gray-300">2. Yüzük Genişliği</span>
                            <span id="widthValue" class="text-gold font-bold">4.5 mm</span>
                        </div>
                        <input type="range" id="widthSlider" min="3" max="8" step="0.5" value="4.5" class="w-full h-1.5 bg-dark-border rounded-lg appearance-none cursor-pointer accent-gold">
                    </div>

                    <div>
                        <label class="text-xs font-semibold uppercase tracking-wider text-gray-300 block mb-1">3. İç Yazı Gravür (Ücretsiz)</label>
                        <input type="text" id="engravingInput" maxlength="20" placeholder="Örn: Efehan 2026" class="w-full bg-black border border-dark-border rounded-lg px-4 py-2.5 text-sm text-white focus:border-gold outline-none">
                    </div>

                    <div class="pt-4 border-t border-dark-border flex items-center justify-between">
                        <div>
                            <span class="text-[10px] uppercase text-gray-400 block">Özel Tasarım Fiyatı</span>
                            <span id="estimatedPrice" class="font-cinzel text-2xl font-bold text-gold">₺18.900</span>
